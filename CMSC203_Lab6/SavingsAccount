public class SavingsAccount extends BankAccount {
	
	private double rate = 0.025;
	private int savingsNumber = 0;
	private String accountNumber;
	
	public SavingsAccount(String name, double balance) {
		super(name, balance);
		accountNumber = super.getAccountNumber().concat("-" + String.valueOf(savingsNumber));
	}
	
	// Copy constructor
	public SavingsAccount(SavingsAccount other, double balance) {
		super(other, balance);
		savingsNumber++;
		accountNumber = super.getAccountNumber().concat("-" + String.valueOf(savingsNumber));
	}
	
	public void postInterest() {
		double monthlyInterest = (super.getBalance() * rate) / 12;
		super.deposit(monthlyInterest);
	}
	
	@Override
	public String getAccountNumber() {
		return accountNumber;
	}
	
	
}
