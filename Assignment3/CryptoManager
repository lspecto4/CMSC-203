/**
 * This is a utility class that encrypts and decrypts a phrase using three
 * different approaches. 
 * 
 * The first approach is called the Vigenere Cipher.Vigenere encryption 
 * is a method of encrypting alphabetic text based on the letters of a keyword.
 * 
 * The second approach is Playfair Cipher. It encrypts two letters (a digraph) 
 * at a time instead of just one.
 * 
 * The third approach is Caesar Cipher. It is a simple replacement cypher. 
 * 
 * @author Huseyin Aygun
 * @version 8/3/2025
 */

public class CryptoManager { 

    private static final char LOWER_RANGE = ' ';
    private static final char UPPER_RANGE = '_';
    private static final int RANGE = UPPER_RANGE - LOWER_RANGE + 1;
    // Use 64-character matrix (8X8) for Playfair cipher  
    private static final String ALPHABET64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 !\"#$%&'()*+,-./:;<=>?@[\\]^_";

    /**
     * This method determines whether the String is within the bounds of ALPHABET64
     * @param plainText The String to be tested
     * @return True if String is within bounds and false if not
     */
    
    public static boolean isStringInBounds(String plainText) {
        for (int i = 0; i < plainText.length(); i++) {
            if (!(plainText.charAt(i) >= LOWER_RANGE && plainText.charAt(i) <= UPPER_RANGE)) {
                return false;
            }
        }
        return true;
    }

	/**
	 * Vigenere Cipher is a method of encrypting alphabetic text 
	 * based on the letters of a keyword. It works as below:
	 * 		Choose a keyword (e.g., KEY).
	 * 		Repeat the keyword to match the length of the plaintext.
	 * 		Each letter in the plaintext is shifted by the position of the 
	 * 		corresponding letter in the keyword (A = 0, B = 1, ..., Z = 25).
	 */
    
    /**
     * Vigenere Encryption
	 * @param plainText String to be encrypted
	 * @param key Key for cipher
	 * @return The encrypted String
	 */   

    public static String vigenereEncryption(String plainText, String key) {
         if (!isStringInBounds(plainText))
        	 return "The selected string is not in bounds, Try again.";
         String encryptedString = "";
         int plainIndex, keyIndex, encryptedIndex;
         char plainChar, keyChar;
         for (int index = 0; index < plainText.length(); index++)
         {
        	 plainChar = plainText.charAt(index);
        	 plainIndex = ALPHABET64.indexOf(plainChar);
        	 keyChar = key.charAt(index % key.length());
        	 keyIndex = ALPHABET64.indexOf(keyChar);
        	 encryptedIndex = (plainIndex + keyIndex) % 64;
        	 encryptedString += ALPHABET64.charAt(encryptedIndex);
         }
         
         return encryptedString;
    }
    
    /**
     * Vigenere Decryption
     * @param encryptedText The String to be decrypted
     * @param key Key for cipher
     * @return The decrypted String
     */
    
    public static String vigenereDecryption(String encryptedText, String key) {
    	if (!isStringInBounds(encryptedText))
       	 return "The selected string is not in bounds, Try again.";
    	String decryptedString = "";
        int encryptedIndex, keyIndex, decryptedIndex;
        char encryptedChar, keyChar;
        for (int index = 0; index < encryptedText.length(); index++)
        {
       	 encryptedChar = encryptedText.charAt(index);
       	 encryptedIndex = ALPHABET64.indexOf(encryptedChar);
       	 keyChar = key.charAt(index % key.length());
       	 keyIndex = ALPHABET64.indexOf(keyChar);
       	 decryptedIndex = (encryptedIndex - keyIndex + 64) % 64;
       	 decryptedString += ALPHABET64.charAt(decryptedIndex);
        }
        
        return decryptedString;
    }


	/**
	 * Playfair Cipher encrypts two letters at a time instead of just one.
	 * It works as follows:
	 * A matrix (8X8 in our case) is built using a keyword
	 * Plaintext is split into letter pairs (e.g., ME ET YO UR).
	 * Encryption rules depend on the positions of the letters in the matrix:
	 *     Same row: replace each letter with the one to its right.
	 *     Same column: replace each with the one below.
	 *     Rectangle: replace each letter with the one in its own row but in the column of the other letter in the pair.
	 */
    
    /**
     * Playfair Encryption
	 * @param plainText The String to be encrypted
	 * @param key Key for cipher
	 * @return The encrypted String
	 */    

    public static String playfairEncryption(String plainText, String key) {
    	if (!isStringInBounds(plainText))
       	 return "The selected string is not in bounds, Try again.";
    	
    	String encryptedString = "";
    	
    	// Create matrix array
    	char[][] matrix = new char[8][8];
    	
    	// Create new String with only unique characters from key
    	String keyWithoutDuplicates = "";
    	keyWithoutDuplicates += key.charAt(0);
    	for (int i = 1; i < key.length(); i++)
    	{
    		char currentChar = key.charAt(i);
    		if (keyWithoutDuplicates.indexOf(currentChar) == -1)
    		{
    			keyWithoutDuplicates += currentChar;
    		}
    	}
    	
    	// Determine how many empty matrix spaces need to be filled after key is populated
    	int spacesToFill = 64 - keyWithoutDuplicates.length();
    	
    	// Create a String of alphabet characters to fill empty matrix spaces
    	String alphabetChars = "";
    	int charsAdded = 0;
    	int alphabetIndex = 0;
    	while (charsAdded < spacesToFill)
    	{
    		char currentChar = ALPHABET64.charAt(alphabetIndex);
    		if (keyWithoutDuplicates.indexOf(currentChar) == -1)
    		{
    			alphabetChars += ALPHABET64.charAt(alphabetIndex);
    			charsAdded++;
    		}
    		alphabetIndex++;
    	}
    	
    	// Create String of 64 characters to fill matrix
    	String matrixChars = keyWithoutDuplicates + alphabetChars;
    	
    	// Populate matrix
    	int matrixCharsIndex = 0;
    	for (int row = 0; row < 8; row++)
    	{
    		for (int column = 0; column < 8; column++)
    		{
    			matrix[row][column] = matrixChars.charAt(matrixCharsIndex);
    			matrixCharsIndex++;
    		}
    	}
    	// Pair off plainText
    	char char1;
    	char char2;
    	// Adds X to end of plaintext string if it has an odd number of chars
    	if (plainText.length() % 2 != 0)
    		plainText += 'X';
    	// Iterates through every two chars in plaintext string
    	for (int i = 0; i < plainText.length(); i += 2)
    	{
    		char1 = plainText.charAt(i);
    		char2 = plainText.charAt(i + 1);
    		
    		int char1IndexRow = -1, char1IndexCol = -1;
    		int char2IndexRow = -1, char2IndexCol = -1;
    		// Find matrix position of each char
    		for (int row = 0; row < 8; row++)
    		{
    			for (int col = 0; col < 8; col++)
    			{
    				if (char1 == matrix[row][col])
    				{
    					char1IndexRow = row;
    					char1IndexCol = col;
    				}
    				else if (char2 == matrix[row][col])
    				{
    					char2IndexRow = row;
    					char2IndexCol = col;
    				}
    			}
    		}
    		// If each char in pair is in the same row but not same col, encrypt to char on the right
    		if (char1IndexRow == char2IndexRow)
    		{
    			encryptedString += matrix[char1IndexRow][(char1IndexCol + 1) % 8];
    			encryptedString += matrix[char2IndexRow][(char2IndexCol + 1) % 8];
    		}
    		// If each char in pair is in the same col but not same row, encrypt to char below
    		else if (char1IndexCol == char2IndexCol)
    		{
    			encryptedString += matrix[(char1IndexRow + 1) % 8][char1IndexCol];
    			encryptedString += matrix[(char2IndexRow + 1) % 8][char2IndexCol];
    		}
    		// If each char in pair is in different row and different column, swap columns
    		else
        	{
        		encryptedString += matrix[char1IndexRow][char2IndexCol];
        		encryptedString += matrix[char2IndexRow][char1IndexCol];
        	}
    	} 	
    	return encryptedString;
    }

    /**
     * Playfair Decryption
     * @param encryptedText The String to be decrypted
     * @param key Key for cipher
     * @return The decrypted String
     */
    
    public static String playfairDecryption(String encryptedText, String key) {
    	if (!isStringInBounds(encryptedText))
       	 return "The selected string is not in bounds, Try again.";
    	
    	String decryptedString = "";
    	
    	// Create matrix array
    	char[][] matrix = new char[8][8];
    	
    	// Create new String with only unique characters from key
    	String keyWithoutDuplicates = "";
    	keyWithoutDuplicates += key.charAt(0);
    	for (int i = 1; i < key.length(); i++)
    	{
    		char currentChar = key.charAt(i);
    		if (keyWithoutDuplicates.indexOf(currentChar) == -1)
    		{
    			keyWithoutDuplicates += currentChar;
    		}
    	}
    	
    	// Determine how many empty matrix spaces need to be filled after key is populated
    	int spacesToFill = 64 - keyWithoutDuplicates.length();
    	
    	// Create a String of alphabet characters to fill empty matrix spaces
    	String alphabetChars = "";
    	int charsAdded = 0;
    	int alphabetIndex = 0;
    	while (charsAdded < spacesToFill)
    	{
    		char currentChar = ALPHABET64.charAt(alphabetIndex);
    		if (keyWithoutDuplicates.indexOf(currentChar) == -1)
    		{
    			alphabetChars += ALPHABET64.charAt(alphabetIndex);
    			charsAdded++;
    		}
    		alphabetIndex++;
    	}
    	
    	// Create String of 64 characters to fill matrix
    	String matrixChars = keyWithoutDuplicates + alphabetChars;
    	
    	// Populate matrix
    	int matrixCharsIndex = 0;
    	for (int row = 0; row < 8; row++)
    	{
    		for (int column = 0; column < 8; column++)
    		{
    			matrix[row][column] = matrixChars.charAt(matrixCharsIndex);
    			matrixCharsIndex++;
    		}
    	}
    	// Pair off encrypted chars
    	char char1;
    	char char2;
    	
    	// Iterates through every two chars in encrypted string
    	for (int i = 0; i < encryptedText.length(); i += 2)
    	{
    		char1 = encryptedText.charAt(i);
    		char2 = encryptedText.charAt(i + 1);
    		
    		int char1IndexRow = -1, char1IndexCol = -1;
    		int char2IndexRow = -1, char2IndexCol = -1;
    		// Find matrix position of each char
    		for (int row = 0; row < 8; row++)
    		{
    			for (int col = 0; col < 8; col++)
    			{
    				if (char1 == matrix[row][col])
    				{
    					char1IndexRow = row;
    					char1IndexCol = col;
    				}
    				else if (char2 == matrix[row][col])
    				{
    					char2IndexRow = row;
    					char2IndexCol = col;
    				}
    			}
    		}
    		// If each char in pair is in the same row but not same col, decrypt to char on the left
    		if (char1IndexRow == char2IndexRow)
    		{
    			decryptedString += matrix[char1IndexRow][(char1IndexCol + 7) % 8];
    			decryptedString += matrix[char2IndexRow][(char2IndexCol + 7) % 8];
    		}
    		// If each char in pair is in the same col but not same row, decrypt to char above
    		else if (char1IndexCol == char2IndexCol)
    		{
    			decryptedString += matrix[(char1IndexRow + 7) % 8][char1IndexCol];
    			decryptedString += matrix[(char2IndexRow + 7) % 8][char2IndexCol];
    		}
    		// If each char in pair is in different row and different column, swap columns
    		else
        	{
    			decryptedString += matrix[char1IndexRow][char2IndexCol];
    			decryptedString += matrix[char2IndexRow][char1IndexCol];
        	}
    	} 	
    	// If the last char in the string is X, remove it
    	if (decryptedString.charAt(decryptedString.length() - 1) == 'X')
    		{
    			String unpaddedDecryptedString = "";
    			for (int i = 0; i < decryptedString.length() - 1; i++)
    				unpaddedDecryptedString += decryptedString.charAt(i);
    			return unpaddedDecryptedString;
    		}
    	else
    		return decryptedString;
    }

    /**
     * Caesar Cipher is a simple substitution cipher that replaces each letter in a message 
     * with a letter some fixed number of positions down the alphabet. 
     * For example, with a shift of 3, 'A' would become 'D', 'B' would become 'E', and so on.
     * 
     */    
    
    /**
     * Caesar Encryption
     * @param plainText The String to be encrypted
     * @param key Key for cipher
     * @return The encrypted String
     */
 
    public static String caesarEncryption(String plainText, int key) {
    	if (!isStringInBounds(plainText))
          	 return "The selected string is not in bounds, Try again.";
    	
    	String encryptedString = "";
    	
    	// For each char in plainText, add shifted char to return string
    	for (int i = 0; i < plainText.length(); i++)
    	{
    		char ch = plainText.charAt(i);
    		int charIndex = ALPHABET64.indexOf(ch);
    		int encryptedIndex = (charIndex + key) % 64;
    		encryptedString += ALPHABET64.charAt(encryptedIndex);	
    	}
    	return encryptedString;
    }

    /**
     * Caesar Decryption
     * @param encryptedText The String to be decrypted
     * @param key Key for cipher
     * @return The decrypted String
     */
    public static String caesarDecryption(String encryptedText, int key) {
    	if (!isStringInBounds(encryptedText))
          	 return "The selected string is not in bounds, Try again.";
    	
    	String decryptedString = "";
    	
    	// For each char in encryptedText, add deshifted char to return string
    	for (int i = 0; i < encryptedText.length(); i++)
    	{
    		char ch = encryptedText.charAt(i);
    		int charIndex = ALPHABET64.indexOf(ch);
    		int encryptedIndex = (charIndex - key + 64) % 64;
    		decryptedString += ALPHABET64.charAt(encryptedIndex);	
    	}
    	return decryptedString;
    }    

}
